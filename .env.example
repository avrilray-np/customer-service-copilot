# 默认使用Mock生成，不调用DeepSeek或Gemini
AI_MODE=mock

# 可选：Mock和AI模式共用真实Hybrid检索；未配置时会明确降级为BM25
# SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RAG_ALLOW_LEXICAL_FALLBACK=true

# 启用真实DeepSeek时改为deepseek，并将密钥只写入未提交的.env.local
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选保留Gemini备用模式
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
