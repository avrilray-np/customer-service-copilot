{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "handling_category",
    "subtypes",
    "risk_level",
    "risk_reason",
    "classification_confidence",
    "reply",
    "evidence_status",
    "recommended_action",
    "knowledge_source_ids",
    "user_data_source_names",
    "missing_information"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "handling_category": { "type": "string", "enum": ["low_risk_info", "low_risk_other", "high_risk"] },
    "subtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "policy_query", "membership_query", "renewal_query", "consumption_record_query",
          "operation_status_query", "unsubscribe", "reissue", "complaint", "suggestion",
          "general_operation", "refund", "report", "account_security", "legal_or_safety"
        ]
      }
    },
    "risk_level": { "type": "string", "enum": ["low", "high"] },
    "risk_reason": { "type": "string", "minLength": 1 },
    "classification_confidence": { "type": "string", "enum": ["high", "low"] },
    "reply": { "type": "string", "minLength": 1 },
    "evidence_status": { "type": "string", "enum": ["sufficient", "insufficient", "conflicting"] },
    "recommended_action": {
      "type": "string",
      "enum": ["reply", "ask_clarification", "assign_tier1", "assign_tier2", "notify_department"]
    },
    "knowledge_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "user_data_source_names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "missing_information": { "type": "array", "items": { "type": "string" } }
  }
}
