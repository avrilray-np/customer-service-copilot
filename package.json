{
  "name": "customer-service-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knowledge:build": "node scripts/build-knowledge-manifest.mjs",
    "knowledge:build-embeddings": "node scripts/build-embedding-index.mjs",
    "rag:evaluate:bm25": "RAG_WRITE_REPORT=1 vitest run tests/evaluation/bm25-baseline.test.ts",
    "rag:evaluate:live": "RAG_LIVE_EVALUATION=1 vitest run tests/evaluation/retrieval-comparison.test.ts",
    "rag:evaluate:formal:bm25": "RAG_WRITE_FORMAL_REPORT=1 vitest run tests/evaluation/formal-rag-bm25.test.ts",
    "rag:evaluate:formal:live": "RAG_LIVE_FORMAL_EVALUATION=1 vitest run tests/evaluation/formal-retrieval-comparison.test.ts",
    "rag:human-template": "node scripts/build-rag-human-template.mjs",
    "rag:smoke:demo": "RAG_LIVE_DEMO=1 vitest run tests/evaluation/demo-rag-runtime.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "2.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
